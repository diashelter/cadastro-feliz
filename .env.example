# Valores padrão para uso local, sem nenhum segredo real.
# `make up-shared` copia este arquivo para .env quando ele não existe.
# Referência: docs/infrastructure.md › Variáveis de ambiente.

# Compartilhadas
API_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGIN=http://localhost:3000
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cadastro_feliz
DB_USERNAME=cadastro_feliz
DB_PASSWORD=cadastro_feliz
LIMITER_REDIS_HOST=redis-limiter
LIMITER_REDIS_PORT=6379
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@cadastro-feliz.local

# Regras de negócio
REGISTRATION_MAX_ATTEMPTS=5
REGISTRATION_ATTEMPT_WINDOW_SECONDS=900
OUTBOX_BATCH_SIZE=100
OUTBOX_REPUBLISH_AFTER_SECONDS=300
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_SECONDS=30

# Específicas de stack
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
